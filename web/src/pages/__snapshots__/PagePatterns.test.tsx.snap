      class="text-[17px] font-semibold text-text"
    >
      Realtime Demo
    </h1>
  </header>
  <main
    class="mx-auto w-full max-w-5xl space-y-4 px-4 py-4"
  >
    <p
      class="text-text-muted"
    >
      Authenticated WebSocket & SSE with device-key JWTs
       
      · 
      <span
        class="font-mono text-xs"
      >
        u1234567
        …
      </span>
       
      ·
       
      <span
        class="font-mono text-xs"
      >
        d1234567
        …
      </span>
    </p>
    <div
      class="grid gap-4 md:grid-cols-2"
    >
      <div
        class="bg-surface border border-border rounded-2xl shadow-sm "
      >
        <div
          class="px-6 py-4 border-b border-border "
        >
          <h2
            class="text-lg font-semibold text-text"
          >
            WebSocket Demo
          </h2>
        </div>
        <div
          class="px-6 py-4 space-y-3"
        >
          <div
            class="flex gap-2"
          >
            <button
              class="inline-flex items-center justify-center gap-2 font-medium rounded-2xl transition-colors disabled:opacity-50 disabled:pointer-events-none bg-primary text-white hover:bg-primary-hover px-4 py-2 text-sm "
              data-testid="ws-connect"
            >
              Connect
            </button>
            <button
              class="inline-flex items-center justify-center gap-2 font-medium rounded-2xl transition-colors disabled:opacity-50 disabled:pointer-events-none bg-danger text-white hover:bg-danger-hover px-4 py-2 text-sm "
              data-testid="ws-disconnect"
              disabled=""
            >
              Disconnect
            </button>
          </div>
          <div
            class="h-48 overflow-y-auto rounded-lg bg-surface-alt p-3 text-xs font-mono text-text"
            data-testid="ws-log"
          />
          <div
            class="flex gap-2"
          >
            <div
              class="space-y-1.5"
            >
              <input
                class="w-full px-3 py-2 bg-surface border border-border rounded-xl text-text placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors  flex-1"
                data-testid="ws-input"
                placeholder="Type a message…"
                type="text"
                value=""
              />
            </div>
            <button
              class="inline-flex items-center justify-center gap-2 font-medium rounded-2xl transition-colors disabled:opacity-50 disabled:pointer-events-none bg-primary text-white hover:bg-primary-hover px-4 py-2 text-sm "
              data-testid="ws-send"
              disabled=""
            >
              Send
            </button>
          </div>
        </div>
      </div>
      <div
        class="bg-surface border border-border rounded-2xl shadow-sm "
      >
        <div
          class="px-6 py-4 border-b border-border "
        >
          <h2
            class="text-lg font-semibold text-text"
          >
            SSE Demo
          </h2>
        </div>
        <div
          class="px-6 py-4 space-y-3"
        >
          <div
            class="flex gap-2"
          >
            <button
              class="inline-flex items-center justify-center gap-2 font-medium rounded-2xl transition-colors disabled:opacity-50 disabled:pointer-events-none bg-primary text-white hover:bg-primary-hover px-4 py-2 text-sm "
              data-testid="sse-start"
            >
              Start Stream
            </button>
            <button
              class="inline-flex items-center justify-center gap-2 font-medium rounded-2xl transition-colors disabled:opacity-50 disabled:pointer-events-none bg-danger text-white hover:bg-danger-hover px-4 py-2 text-sm "
              data-testid="sse-stop"
              disabled=""
            >
              Stop Stream
            </button>
          </div>
          <div
            class="h-48 overflow-y-auto rounded-lg bg-surface-alt p-3 text-xs font-mono text-text"
            data-testid="sse-log"
          />
        </div>
      </div>
    </div>
  </main>
</div>
`;
